#!/usr/bin/env bash
# Bundled helper for Omarchy Google Calendar and Clock.
set -euo pipefail

CACHE_FILE="${HOME}/.local/state/omarchy/calendar-cache.json"
if [[ ! -f "$CACHE_FILE" || -L "$CACHE_FILE" || ! -r "$CACHE_FILE" ]]; then
  printf '{"ok":false,"error":"Calendar cache is not ready yet"}\n'
  exit 0
fi

# Never hand an unbounded local cache to the long-lived Quickshell process.
cache_bytes=$(wc -c < "$CACHE_FILE")
if (( cache_bytes > 2097152 )); then
  printf '{"ok":false,"error":"Calendar cache exceeds the size limit"}\n'
  exit 0
fi

jq -c 'if .ok == true and (.events | type == "array") then . else {ok:false,error:"Calendar cache is invalid"} end' "$CACHE_FILE"

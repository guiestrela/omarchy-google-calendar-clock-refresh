#!/usr/bin/env bash
# Bundled helper for Omarchy Google Calendar and Clock.
set -euo pipefail
umask 077

# Caldir keeps each calendar's color in <calendar_dir>/<slug>/.caldir/
# config.toml and writes it only when the calendar is connected, so palette
# changes made on the Google side never reach the clock. This helper
# re-reads the current colors from the Calendar API using the existing OAuth
# session and updates the local configs in place. It is best-effort:
# offline or unauthenticated runs keep the last-known colors and exit 0.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
CALDIR_BIN="${SCRIPT_DIR}/calendar-caldir"

[[ -x "$CALDIR_BIN" ]] || { echo "Caldir runtime is not installed" >&2; exit 127; }
command -v curl >/dev/null || { echo "curl is required to refresh calendar colors" >&2; exit 0; }
command -v jq >/dev/null || { echo "jq is required to refresh calendar colors" >&2; exit 0; }

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
GOOGLE_CONFIG_DIR="${CONFIG_HOME}/caldir/providers/google"
SESSION_DIR="${GOOGLE_CONFIG_DIR}/session"
APP_CONFIG="${GOOGLE_CONFIG_DIR}/app_config.toml"
MAX_API_RESPONSE_BYTES=1048576
CURL_LIMITS=(--connect-timeout 10 --max-time 30 --max-filesize "$MAX_API_RESPONSE_BYTES")

calendar_dir=$("$CALDIR_BIN" config --json | jq -r '.config.calendar_dir')
calendar_dir="${calendar_dir/#\~/$HOME}"
[[ -n "$calendar_dir" && -d "$calendar_dir" ]] || exit 0

# toml_value <file> <key>: print the quoted value of a TOML key.
toml_value() {
  awk -F' = ' -v key="$2" '$1 == key { gsub(/^"|"$/, "", $2); print $2; exit }' "$1"
}

# refresh_token_for <session_file>: print a usable access token, exchanging
# the stored refresh token when the stored access token is near expiry.
# Direct sessions exchange through Google with their own OAuth client;
# hosted sessions (created via `setup --hosted`) exchange through caldir.org's
# relay, because they have no local client credentials.
refresh_token_for() {
  local session_file=$1
  local access_token expires_at auth_mode client_id client_secret response
  access_token=$(toml_value "$session_file" access_token)
  expires_at=$(toml_value "$session_file" expires_at)
  if [[ -n "$expires_at" ]] && date -d "$expires_at" >/dev/null 2>&1 \
    && [[ $(date -d "$expires_at" +%s) -gt $(( $(date +%s) + 120 )) ]]; then
    printf '%s' "$access_token"
    return 0
  fi
  auth_mode=$(toml_value "$session_file" auth_mode)
  if [[ "$auth_mode" == "hosted" ]]; then
    response=$(curl --fail --silent --show-error "${CURL_LIMITS[@]}" \
      -H "Content-Type: application/json" \
      --data @- "https://caldir.org/auth/google/refresh" 2>/dev/null <<EOF
{"refresh_token":"$(toml_value "$session_file" refresh_token)"}
EOF
    ) || return 1
  else
    client_id=$(toml_value "$APP_CONFIG" client_id)
    client_secret=$(toml_value "$APP_CONFIG" client_secret)
    [[ -n "$client_id" && -n "$client_secret" ]] || return 1
    response=$(curl --fail --silent --show-error "${CURL_LIMITS[@]}" \
      --data-urlencode "client_id=$client_id" \
      --data-urlencode "client_secret=$client_secret" \
      --data-urlencode "refresh_token=$(toml_value "$session_file" refresh_token)" \
      --data-urlencode "grant_type=refresh_token" \
      "https://oauth2.googleapis.com/token" 2>/dev/null) || return 1
  fi
  jq -r '.access_token // empty' <<<"$response"
}

shopt -s nullglob
for session_file in "$SESSION_DIR"/*.toml; do
  auth_mode=$(toml_value "$session_file" auth_mode)
  if [[ "$auth_mode" != "hosted" ]] && [[ ! -f "$APP_CONFIG" ]]; then
    continue
  fi
  access_token=$(refresh_token_for "$session_file") || continue
  [[ -n "$access_token" ]] || continue
  calendar_list=$(curl --fail --silent --show-error "${CURL_LIMITS[@]}" \
    -H "Authorization: Bearer $access_token" \
    "https://www.googleapis.com/calendar/v3/users/me/calendarList?minAccessRole=reader&fields=items(id,backgroundColor)" 2>/dev/null) || continue
  color_map=$(jq -c '.items | map(select(.backgroundColor != null)) | map({key: .id, value: .backgroundColor}) | from_entries' <<<"$calendar_list" 2>/dev/null)
  [[ -n "$color_map" && "$color_map" != "{}" ]] || continue

  for config in "$calendar_dir"/*/.caldir/config.toml; do
    [[ -f "$config" ]] || continue
    cal_id=$(toml_value "$config" google_calendar_id)
    [[ -n "$cal_id" ]] || continue
    color=$(jq -r --arg id "$cal_id" '.[$id] // empty' <<<"$color_map")
    [[ "$color" =~ ^#[0-9A-Fa-f]{6}$ ]] || continue
    if [[ "$(toml_value "$config" color)" != "$color" ]]; then
      temporary=$(mktemp "$config.XXXXXX")
      awk -v color="$color" '/^color = / { printf "color = \"%s\"\n", color; next } { print }' "$config" >"$temporary"
      chmod 600 "$temporary"
      mv -f "$temporary" "$config"
      echo "Updated calendar color for ${cal_id} to ${color}"
    fi
  done
done
